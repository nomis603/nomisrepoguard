```gitignore
# Dependencies
node_modules/
vendor/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build output
dist/
build/
out/
coverage/

# Cache
.cache/
.parcel-cache/
.next/
.nuxt/
.turbo/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
*.bak

# ScanRepo output (if generated locally)
scanrepo-report.json
scanrepo-output.json

# Local configuration
.npmrc.local
